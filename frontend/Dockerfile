FROM node:20-alpine

WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .

ARG VITE_SIGNALING_URL=ws://localhost:8080/ws
ARG VITE_MEDIA_SERVER_URL=http://localhost:8080
ARG VITE_PUSH_SERVICE_URL=http://localhost:8082

ENV VITE_SIGNALING_URL=$VITE_SIGNALING_URL
ENV VITE_MEDIA_SERVER_URL=$VITE_MEDIA_SERVER_URL
ENV VITE_PUSH_SERVICE_URL=$VITE_PUSH_SERVICE_URL

EXPOSE 3000

CMD ["npm", "run", "dev"]
